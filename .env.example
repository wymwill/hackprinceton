# Supabase project (Settings → API). Both the API and the frontend build read these.
# Use the publishable (anon) key for the frontend and normal signed-in requests.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The House: optional, server-only. Never use NEXT_PUBLIC_ or VITE_ for these.
# With no key, real events still receive deterministic commentary.
OPENAI_API_KEY=
OPENAI_HOUSE_MODEL=gpt-4.1-mini
# auto: use OpenAI when configured; fallback: no model calls; mock: local mock choice.
HOUSE_MODE=auto
# Optional persistent shared directory. Defaults to ignored .data/house locally.
# On Vercel, paid generation stays disabled without an explicit persistent mount.
HOUSE_CACHE_DIR=

# GitHub public activity: optional server token to increase API request capacity.
# No OAuth app or client secret is needed. Never use NEXT_PUBLIC_ or VITE_.
# GITHUB_TOKEN=

# AI game planner: server-only Gemini API key from Google AI Studio.
GOOGLE_API_KEY=
# GEMINI_API_KEY is also accepted as an alias.
GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite

# Photon 2.0 iMessage: all server-only. No VITE_ or NEXT_PUBLIC_ prefix.
# Optional: keep blank to disable messaging. See docs/photon.md.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
PHOTON_WEBHOOK_SECRET=
# The assigned iMessage phone number/address, displayed to players for pairing.
PHOTON_IMESSAGE_ADDRESS=
# Privileged server credential, used only by verified webhooks and the queue worker.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret for the protected retry worker, invoked by your hosting scheduler.
CRON_SECRET=
