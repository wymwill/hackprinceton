# Sign-in with Google through Supabase Auth. See "Sign-in" in the README for the setup.
# The Bet Series API (/api/series/*) uses the same two values; see docs/supabase-series.md.
# Use the publishable (anon) key only. Never put the service_role / secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# For a local demo without accounts (the "Playing as" switcher), set this instead.
# Never use it where real people sign in.
# BWF_AUTH=demo

# AI Bookie. With a key, Claude sets odds and reviews settlement evidence.
# Without one, odds come from stored history only and every result goes to a person.
ANTHROPIC_API_KEY=

# Optional overrides
# BOOKIE_AI=claude          # claude, off, or stub (stub is for tests only)
# BOOKIE_AI_MODEL=claude-opus-5-5
