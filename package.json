{
  "name": "alea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "build": "npm --prefix frontend run build && next build",
    "start": "next start",
    "postinstall": "npm --prefix frontend install --no-audit --no-fund",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm --prefix frontend run typecheck",
    "test:series-sql": "node --test tests/sql/series.test.mjs tests/sql/outcomes.test.mjs tests/sql/ranges.test.mjs tests/sql/upgrade.test.mjs tests/sql/social.test.mjs tests/sql/chat.test.mjs tests/sql/clan-series.test.mjs tests/sql/idempotency.test.mjs tests/sql/deadlines.test.mjs tests/sql/reminders.test.mjs tests/sql/links.test.mjs tests/sql/tutorial.test.mjs tests/sql/photon.test.mjs",
    "test:series": "node tests/e2e/series.mjs",
    "create:demo-users": "node scripts/create-demo-users.mjs",
    "test:outcomes-local": "node tests/e2e/outcomes-local.mjs",
    "test:ranges-local": "node tests/e2e/ranges-local.mjs",
    "test:chat-local": "node tests/e2e/chat-local.mjs",
    "test:house": "node --conditions=react-server --experimental-strip-types --test tests/unit/house.test.mjs",
    "test:wrapped": "node --experimental-strip-types --test tests/unit/wrapped.test.mjs",
    "test:recap": "node --experimental-strip-types --test tests/unit/recap.test.mjs",
    "test:recap-ui": "playwright test --config=playwright.house.config.mjs recap.spec.mjs",
    "test:wrapped-local": "node tests/e2e/wrapped-local.mjs",
    "test:idempotency-local": "node tests/e2e/idempotency-local.mjs",
    "test:deadlines-local": "node tests/e2e/deadlines-local.mjs",
    "test:deadlines-ui": "playwright test --config=playwright.house.config.mjs deadlines.spec.mjs",
    "test:submissions-ui": "playwright test --config=playwright.house.config.mjs submissions.spec.mjs",
    "test:wrapped-ui": "playwright test --config=playwright.house.config.mjs wrapped.spec.mjs",
    "test:house-local": "node tests/e2e/house-local.mjs",
    "test:house-ui": "playwright test --config=playwright.house.config.mjs",
    "test:planner": "node --conditions=react-server --experimental-strip-types --test tests/unit/game-planner.test.mjs",
    "test:tour": "node --experimental-strip-types --test tests/unit/navigation-tour.test.mjs",
    "test:solana": "node --experimental-strip-types --test tests/unit/solana-receipt.test.mjs",
    "test:photon": "node --conditions=react-server --experimental-strip-types --test tests/unit/photon.test.mjs tests/unit/photon-send.test.mjs && node --test tests/sql/photon.test.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.4.1",
    "@langchain/google": "^0.2.15",
    "@supabase/supabase-js": "^2.119.0",
    "deepagents": "^1.16.5",
    "langchain": "^1.6.6",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
