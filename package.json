{
  "name": "alea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "build": "npm --prefix frontend run build && next build",
    "start": "next start",
    "postinstall": "npm --prefix frontend install --no-audit --no-fund",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm --prefix frontend run typecheck",
    "test:series-sql": "node --test supabase/tests/series.test.mjs supabase/tests/outcomes.test.mjs supabase/tests/upgrade.test.mjs",
    "test:series": "node scripts/e2e-series.mjs",
    "create:demo-users": "node scripts/create-demo-users.mjs",
    "test:outcomes-local": "node scripts/e2e-outcomes-local.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
