# Supabase project (Settings → API). Both the API and the frontend build read these.
# Use the publishable (anon) key only. Never put the service_role / secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The House: optional, server-only. Never use NEXT_PUBLIC_ or VITE_ for these.
# With no key, real events still receive deterministic commentary.
OPENAI_API_KEY=
OPENAI_HOUSE_MODEL=gpt-4.1-mini
# auto: use OpenAI when configured; fallback: no model calls; mock: local mock choice.
HOUSE_MODE=auto
# Optional persistent shared directory. Defaults to ignored .data/house locally.
# On Vercel, paid generation stays disabled without an explicit persistent mount.
HOUSE_CACHE_DIR=

# Linked accounts (all optional): proof for bets from other apps. Server only;
# each client ID is also sent to browsers to start that app's sign-in.
# Setup and redirect URIs: docs/linked-accounts.md. An app without its ID shows
# "Not set up on this server yet" on the profile page.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# SPOTIFY_CLIENT_ID=
# GitHub needs no app: people link a public username. A token (no scopes needed)
# raises GitHub's limit for this server from 60 to 5,000 requests an hour.
# GITHUB_TOKEN=

# AI game planner: server-only Gemini API key from Google AI Studio.
GOOGLE_API_KEY=
# GEMINI_API_KEY is also accepted as an alias.
GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite
